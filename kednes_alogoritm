#include <stdio.h>

// Helper macro to find the maximum of two numbers
#define MAX(a, b) ((a) > (b) ? (a) : (b))

int maxSubArray(int nums[], int n) {
    int max_current = nums[0];
    int max_global = nums[0];

    for (int i = 1; i < n; i++) {
        // Step 1: Decide to extend the current subarray or start a new one
        max_current = MAX(nums[i], max_current + nums[i]);

        // Step 2: Update the global maximum if the current one is better
        if (max_current > max_global) {
            max_global = max_current;
        }
    }
    return max_global;
}

int main() {
    int arr[] = {-2, 1, -3, 4, -1, 2, 1, -5, 4};
    int n = sizeof(arr) / sizeof(arr[0]);

    int result = maxSubArray(arr, n);
    printf("The Maximum Subarray Sum is: %d\n", result);

    return 0;
}
