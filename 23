class Solution {
public:
    bool check(vector<int>& nums) {
        int count = 0;
        int n = nums.size();
        
        for (int i = 0; i < n; i++) {
            // Check if the current element is greater than the next element
            // Using % n handles the wrap-around comparison between the last and first element
            if (nums[i] > nums[(i + 1) % n]) {
                count++;
            }
            
            // Optimization: If we find more than 1 drop, it can't be sorted and rotated
            if (count > 1) {
                return false;
            }
        }
        
        return true;
    }
};
